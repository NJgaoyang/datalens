# LOCAL DEVELOPMENT ONLY. Replace both values before starting; never use production credentials.
DATALENS_DB_PASSWORD=local-dev-only-change-me
DATALENS_MYSQL_ROOT_PASSWORD=local-root-only-change-me
DATALENS_WEB_PORT=8088

# Optional first-run super admin: set both with a unique password (12–72 UTF-8 bytes).
# Consumed only if there are no users. Remove after provisioning. No default credentials.
DATALENS_BOOTSTRAP_USERNAME=
DATALENS_BOOTSTRAP_PASSWORD=
# false is only for this localhost HTTP development Compose stack
DATALENS_COOKIE_SECURE=false

# Optional M02: external base64 32-byte runtime key and exact numeric IPv4:port allowlist.
# Leave empty for zero-source startup. Never commit a real key or credential.
DATALENS_SOURCE_KEY=
DATALENS_SOURCE_ALLOWED_ENDPOINTS=

# Optional M07 model wrapping key and exact approved numeric HTTPS endpoints.
# Empty defaults: model disabled; no provider request during startup.
DATALENS_MODEL_KEY=
DATALENS_MODEL_ALLOWED_ENDPOINTS=

# Optional non-destructive history admission guardrails. See docs/M10-capacity-hardening.md.
# Defaults are not production sizing; raising limits needs storage/load review. No automatic deletion.
# DATALENS_CAPACITY_QUERY_TOTAL=10000
# DATALENS_CAPACITY_QUERY_PER_ACTOR=1000
# DATALENS_CAPACITY_CONVERSATION_TOTAL=1000
# DATALENS_CAPACITY_CONVERSATION_PER_ACTOR=100
# DATALENS_CAPACITY_MODEL_TOTAL=10000
# DATALENS_CAPACITY_MODEL_PER_ACTOR=1000
# Chart environment variable names/defaults are listed in docs/M10-capacity-hardening.md.
