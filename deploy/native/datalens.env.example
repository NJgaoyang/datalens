# Copy to /etc/datalens/datalens.env (chmod 600); never commit real credentials.
DATALENS_BIND_ADDRESS=127.0.0.1
DATALENS_PORT=8080
DATALENS_DB_URL=jdbc:mysql://127.0.0.1:3306/datalens?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&sslMode=DISABLED&allowPublicKeyRetrieval=true
DATALENS_DB_USERNAME=root
DATALENS_DB_PASSWORD=REPLACE_LOCALLY
# HTTP loopback + SSH tunnel only; set true for approved HTTPS ingress.
DATALENS_COOKIE_SECURE=false
# Set on first run, remove afterwards.
DATALENS_BOOTSTRAP_USERNAME=admin
DATALENS_BOOTSTRAP_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_ADMIN_PASSWORD
# Persistent base64 32-byte AES key: openssl rand -base64 32
DATALENS_SOURCE_KEY=REPLACE_WITH_PERSISTENT_BASE64_32_BYTE_KEY
# StarRocks FE numeric address with MySQL port; e.g. 10.20.30.40:9030
DATALENS_SOURCE_ALLOWED_ENDPOINTS=
# Optional model, not needed for initial startup
DATALENS_MODEL_KEY=
DATALENS_MODEL_ALLOWED_ENDPOINTS=
