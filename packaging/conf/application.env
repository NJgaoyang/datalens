# DataLens Linux tar.gz runtime configuration.
# This file is sourced by bin/start.sh. Quote values containing $, #, &, spaces, etc.
# Set filesystem permissions to 600; never commit the edited copy.

# Direct IP:port access (no Nginx). Restrict your firewall to trusted clients.
DATALENS_BIND_ADDRESS='0.0.0.0'
DATALENS_PORT=8088

# Greenfield first-install defaults for the user's local MySQL 8 only.
# These sample values are PUBLIC defaults, not secrets. Change them for real deployments.
# A new/empty datalens schema is required. Existing schemas are never dropped automatically.
# Local MySQL 8 metadata, sessions and login counters.
# createDatabaseIfNotExist requires CREATE privilege for first bootstrap.
DATALENS_DB_URL='jdbc:mysql://127.0.0.1:3306/datalens?createDatabaseIfNotExist=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&sslMode=DISABLED&allowPublicKeyRetrieval=true'
DATALENS_DB_USERNAME='root'
DATALENS_DB_PASSWORD='123456'

# First launch only: creates admin if no users exist; an existing account is never reset.
# Default credentials are for isolated initial installation only.
# Change the admin password after first login, then clear BOTH bootstrap values.
DATALENS_BOOTSTRAP_USERNAME='admin'
DATALENS_BOOTSTRAP_PASSWORD='admin@123456'

# When using plain HTTP on a trusted LAN: false. For HTTPS, must be true.
# Plain HTTP transmits login credentials unencrypted and is NOT safe on the public internet.
DATALENS_COOKIE_SECURE=false

# External StarRocks: enter the exact FE numeric IPv4 and SQL/MySQL port (usually 9030).
# Example: DATALENS_SOURCE_ALLOWED_ENDPOINTS='10.20.30.40:9030'
# Generate the separate persistent encryption key using: openssl rand -base64 32
DATALENS_SOURCE_ALLOWED_ENDPOINTS=''
DATALENS_SOURCE_KEY=''

# Optional AI provider; no provider required at app startup.
DATALENS_MODEL_ALLOWED_ENDPOINTS=''
DATALENS_MODEL_KEY=''

JAVA_XMS=256m
JAVA_XMX=1024m

# Optional built-in HTTPS in Spring Boot (no reverse proxy needed):
# SERVER_SSL_ENABLED=true
# SERVER_SSL_KEY_STORE='file:/absolute/path/to/server.p12'
# SERVER_SSL_KEY_STORE_TYPE='PKCS12'
# SERVER_SSL_KEY_STORE_PASSWORD='YOUR_LOCAL_SECRET'
# DATALENS_COOKIE_SECURE=true
# Note: a certificate with the server IP in its Subject Alternative Name is required.
